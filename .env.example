# --- Required ---
LOOKER_BASE_URL=https://your-instance.cloud.looker.com
LOOKER_CLIENT_ID=your_client_id
LOOKER_CLIENT_SECRET=your_client_secret
LOOKER_PROJECT_ID=your-project-id

# --- Branch Safety (optional) ---
# Agent auto-detects current branch from Looker on startup.
# Control branch via Looker UI — no config needed.
#
# LOOKER_ALLOWED_BRANCHES — which branches the agent can switch to.
# Default: * (any branch). Set to restrict: feat/a,feat/b
# LOOKER_ALLOWED_BRANCHES=*
#
# LOOKER_RESET_BRANCHES — which branches allow reset_to_remote (destructive).
# Default: none. Must be explicitly listed. No wildcards.
# LOOKER_RESET_BRANCHES=feat/unified_users,feat/expired_calls

# --- Optional ---
# LOOKER_SANDBOX_FOLDER_ID — folder for import_lookml_dashboard UDD copies
# LOOKER_SANDBOX_FOLDER_ID=85
